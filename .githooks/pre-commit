#!/usr/bin/env bash
# Pre-commit hook: mirror the CI ruff checks before allowing the commit.
#
# Activated per-clone by running:
#   git config core.hooksPath .githooks
#
# The hook is intentionally check-only (matches CI exactly, no auto-edit
# of staged files). If a check fails, run the fix command it prints, stage
# the result, and re-commit.

set -e

# Skip if no Python files are staged — keeps doc/config-only commits instant.
staged_py=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)
if [ -z "$staged_py" ]; then
    exit 0
fi

# Locate a ruff invocation. CI uses `uv run ruff`, which is also what most
# contributors have. If uv isn't on PATH (e.g. Git Bash on Windows where uv
# is installed but only visible to PowerShell), fall back to a project-local
# .venv ruff, then a global ruff, then warn-and-skip rather than blocking
# the commit with a tooling problem.
run_ruff() {
    if command -v uv >/dev/null 2>&1; then
        uv run ruff "$@"
    elif [ -x "./.venv/bin/ruff" ]; then
        ./.venv/bin/ruff "$@"
    elif [ -x "./.venv/Scripts/ruff.exe" ]; then
        ./.venv/Scripts/ruff.exe "$@"
    elif command -v ruff >/dev/null 2>&1; then
        ruff "$@"
    else
        return 127
    fi
}

if ! run_ruff --version >/dev/null 2>&1; then
    echo "[pre-commit] ruff not found (uv missing and no .venv ruff). Skipping checks."
    echo "  CI will still run them. To enable local pre-commit lint, install uv:"
    echo "    https://docs.astral.sh/uv/getting-started/installation/"
    exit 0
fi

echo "[pre-commit] ruff check ."
if ! run_ruff check .; then
    echo ""
    echo "  Lint failed. To auto-fix what's safe:"
    echo "    uv run ruff check --fix .   # (or substitute your ruff invocation)"
    echo "  Then re-stage and re-commit."
    exit 1
fi

echo "[pre-commit] ruff format --check ."
if ! run_ruff format --check .; then
    echo ""
    echo "  Format check failed. To apply formatting:"
    echo "    uv run ruff format ."
    echo "  Then re-stage and re-commit."
    exit 1
fi
