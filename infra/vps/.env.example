# VPS environment — copy to .env and fill in secrets
# This file is committed; .env is gitignored.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scheduler

# Async URL for runtime services (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/scheduler

# Sync URL for Alembic migrations (psycopg)
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:change-me@postgres:5432/scheduler

# ── ElasticMQ / SQS ───────────────────────────────────────────────────────────
QUEUE_URL=http://elasticmq:9324/queue/task-queue
QUEUE_DLQ_URL=http://elasticmq:9324/queue/task-dlq

# ── App ───────────────────────────────────────────────────────────────────────
MCP_USER_ID=default-user
MCP_USER_TZ=Asia/Tokyo
PORT=8000
LOG_LEVEL=INFO

# ── Cloudflare R2 (backup) ────────────────────────────────────────────────────
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me

# ── Rate limiting (ADR-042) ───────────────────────────────────────────────────
# Max task.create.v1 calls per user per 24 h (default 1000)
RATE_LIMIT_DAILY=1000
# Max task.create.v1 calls per user per minute — burst cap (default 10)
RATE_LIMIT_BURST_PER_MINUTE=10

# ── Observability (Better Stack via Vector) ──────────────────────────────────
# Source token from Better Stack → Telemetry → Sources → (your source) → Logs.
# Ingesting host is the bare hostname Better Stack shows, e.g.
#   s1234567.eu-nbg-2.betterstackdata.com   (no scheme, no trailing slash)
BETTER_STACK_SOURCE_TOKEN=change-me
BETTER_STACK_INGESTING_HOST=change-me.betterstackdata.com

# ── W4 placeholders ───────────────────────────────────────────────────────────
# GITHUB_PAT=change-me
# SLACK_WEBHOOK_URL=change-me
