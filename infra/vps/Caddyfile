{
    # Force Let's Encrypt production explicitly.
    # Caddy's default issuer chain can fall back to staging after repeated
    # failures (e.g. NXDOMAIN cached during initial DNS propagation), and
    # staging certs are not trusted by browsers. Pinning prod prevents that
    # state from sticking after the underlying DNS issue is resolved.
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

scheduler.paynepew.dev {
    encode gzip zstd
    log {
        output file /var/log/caddy/access.log
    }

    handle /healthz {
        reverse_proxy mcp-server:8000
    }

    handle /mcp* {
        reverse_proxy mcp-server:8000
    }

    handle / {
        root * /var/www
        file_server
    }
}
