{
    # Force Let's Encrypt production explicitly.
    # Caddy's default issuer chain can fall back to staging after repeated
    # failures (e.g. NXDOMAIN cached during initial DNS propagation), and
    # staging certs are not trusted by browsers. Pinning prod prevents that
    # state from sticking after the underlying DNS issue is resolved.
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

scheduler.paynepew.dev {
    encode gzip zstd
    log {
        output file /var/log/caddy/access.log
    }

    handle /healthz* {
        reverse_proxy mcp-server:8000
    }

    handle /mcp* {
        # ADR-057: shed at the Caddy edge before business logic.
        # When /healthz/shed returns 503, Caddy marks the backend unhealthy
        # and returns 503 + Retry-After directly (fail_duration keeps it
        # unhealthy for 10 s to avoid hammering the health endpoint under load).
        reverse_proxy mcp-server:8000 {
            health_uri /healthz/shed
            health_interval 5s
            health_timeout 2s
            fail_duration 10s
            unhealthy_status 503
        }
    }

    handle / {
        root * /var/www
        file_server
    }
}
