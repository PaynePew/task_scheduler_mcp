# Copy this file to .env for host-side development (e.g. `uv run alembic upgrade head`).
# .env is gitignored — never commit real credentials.
#
# For services running inside docker-compose, see .env.docker (committed,
# uses compose-internal hostnames like `postgres` / `elasticmq`).

# Async URL for runtime services (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Sync URL for Alembic migrations (psycopg)
ALEMBIC_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# SQS / ElasticMQ queue URL
QUEUE_URL=http://localhost:9324/queue/task-queue

# Fallback user identity for stdio transport and HTTP requests without an identity header
MCP_USER_ID=default-user

# Optional IANA timezone forwarded from the client's local environment (ADR-017).
# Used as step 3 of the 4-step resolver: call-arg > X-Timezone header > MCP_USER_TZ > "UTC"
# Example: MCP_USER_TZ=America/New_York
# MCP_USER_TZ=

# HTTP transport bind port (used by the mcp-http entrypoint)
PORT=8000

# Logging verbosity
LOG_LEVEL=INFO

# Dead-letter queue URL — added in S07b when the DLQ is wired
QUEUE_DLQ_URL=http://localhost:9324/queue/task-dlq

# Reconciler grace windows (issue #30).
# DLQ grace: how long a RETRYING row must be stale before the reconciler declares it FAILED.
# Default 180s = VisibilityTimeout(30s) * (MaxReceiveCount(3)+1) + slack(60s).
RECONCILER_DLQ_GRACE_SECONDS=180
# QUEUED grace: how long a QUEUED row must be stale before the reconciler re-enqueues it.
# Default 90s = VisibilityTimeout(30s) * 2 + slack(30s).
RECONCILER_QUEUED_GRACE_SECONDS=90

# WorkOS HTTP resource-server auth (ADR-053) is only enforced by the HTTP
# entrypoint that runs inside docker-compose — see .env.docker.example for the
# full block. Host-side stdio MCP runs in trust-only mode (ADR-015) and ignores
# these vars. The two values below are documented here for completeness:
#   WORKOS_AUDIENCE      — JWT ``aud`` value (WorkOS Client ID in the SSO flow).
#   WORKOS_RESOURCE_URL  — URL advertised in PRM ``resource`` (issue #189).
# WORKOS_AUDIENCE=
# WORKOS_RESOURCE_URL=
