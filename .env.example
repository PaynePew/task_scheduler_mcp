# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  copy to `.env` for HOST-SIDE dev:
#                     - `uv run alembic upgrade head`
#                     - `uv run pytest`
#                     - `uv run python -m app.entrypoints.mcp_stdio` (Path C)
#                   Uses localhost hostnames; gitignored.
#
#  Which file does what (README §3 deployment paths):
#    `.env`            (this template's target) — host-side `uv run` commands
#    `.env.docker`     (separate template)      — docker-compose stack
#                                                 (compose reads ONLY .env.docker;
#                                                 `cp .env.example .env` does NOT
#                                                 supply env to compose).
#
#  Deployment-path quick guide:
#    Path A — Hosted (https://scheduler.paynepew.dev/mcp): you don't run this server.
#    Path B — Self-host HTTP : edit `.env.docker`, NOT this file. This file's
#                              values are only consulted by host-side `uv run`.
#    Path C — Self-host stdio: this file's MCP_USER_ID is read by the stdio process;
#                              `.env.docker`'s MCP_USER_ID is read by the web tier
#                              (which serves /connections). They MUST match —
#                              see CONNECTIONS_BASE_URL block (§8) below.
#
#  Source of truth for variable names: app/config/settings.py (ADR-010).
#  Anything below that is left blank means: not required for `echo` + `http_call`.
#  Each block notes the ADR that authorised it and the feature it gates.
# ─────────────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════════════════
#  1. Database & queue  (REQUIRED — server won't boot without these)
# ════════════════════════════════════════════════════════════════════════════

# Async URL for runtime services (SQLAlchemy + asyncpg).  ADR-011.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Sync URL for Alembic migrations (psycopg).  Must point at the same DB.
ALEMBIC_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# SQS / ElasticMQ queue URLs.  ADR-008.
QUEUE_URL=http://localhost:9324/queue/task-queue
QUEUE_DLQ_URL=http://localhost:9324/queue/task-dlq


# ════════════════════════════════════════════════════════════════════════════
#  2. Server identity & runtime
# ════════════════════════════════════════════════════════════════════════════

# Fallback user_id when stdio transport runs without a header (ADR-015).
#
# Resolution by transport:
#   - HTTP + WorkOS (Path B prod): JWT `sub` claim — this var is IGNORED.
#   - HTTP trust-only (Path B dev): `X-User-Id` header → this var → "default-user".
#   - stdio (Path C):               always this var → "default-user".
#
# Path C critical: the stdio process (reads this `.env`) and the web tier on
# :8000 (reads `.env.docker`) must resolve to the SAME string, otherwise
# OAuth connections land on the wrong user and every action returns
# MISSING_CONNECTION.  Keep this in sync with `.env.docker`'s MCP_USER_ID.
MCP_USER_ID=default-user

# Optional IANA timezone forwarded from the client's environment (ADR-017).
# Resolver order: call-arg > X-Timezone header > MCP_USER_TZ > "UTC".
# MCP_USER_TZ=America/New_York

# HTTP transport bind port.
PORT=8000

# Logging verbosity (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO

# Operator's WorkOS sub (ADR-055).  When set, this user is:
#   - exempt from rate-limit + containment caps, and
#   - allowed to invoke `requires_operator=True` actions.
# Leave blank in local dev.  Migration 0005 reads OPERATOR_USER_ID directly
# from env — keep both in sync at deploy time.
# OPERATOR_USER_ID=


# ════════════════════════════════════════════════════════════════════════════
#  3. Reconciler grace windows  (issue #30, recalibrated in #270)
# ════════════════════════════════════════════════════════════════════════════
# Both graces are derived from the worker's actual per-receive VisibilityTimeout
# (60s — see app/workers/executor.py), not the SQS main queue's 30s default.

# How long a RETRYING row must be stale before reconciler declares it FAILED.
# Default 300s = VisibilityTimeout(60s) × (MaxReceiveCount(3)+1) + slack(60s).
RECONCILER_DLQ_GRACE_SECONDS=300

# How long a QUEUED row must be stale before reconciler re-enqueues it.
# Default 150s = VisibilityTimeout(60s) × 2 + slack(30s).
RECONCILER_QUEUED_GRACE_SECONDS=150

# How long the reconciler loop sleeps between sweeps.
RECONCILER_INTERVAL_SECONDS=60


# ════════════════════════════════════════════════════════════════════════════
#  4. Rate limit & containment caps  (ADR-042, ADR-055)
# ════════════════════════════════════════════════════════════════════════════
# Per-user limits for task.create.v1.  Operator (OPERATOR_USER_ID) is exempt.

RATE_LIMIT_DAILY=100
RATE_LIMIT_BURST_PER_MINUTE=5

QUOTA_ACTIVE_RECURRING_PER_USER=5
QUOTA_ACTIVE_TOTAL_PER_USER=50
QUOTA_GLOBAL_ACTIVE_RECURRING=500


# ════════════════════════════════════════════════════════════════════════════
#  5. Overload protection  (ADR-057)
# ════════════════════════════════════════════════════════════════════════════

OVERLOAD_CPU_THRESHOLD=0.90
OVERLOAD_RAM_THRESHOLD=0.90
OVERLOAD_QUEUE_DEPTH_THRESHOLD=1000
OVERLOAD_BACKPRESSURE_QUEUE_DEPTH=500
OVERLOAD_CONCURRENCY_LIMIT=10
OVERLOAD_RETRY_AFTER_SECONDS=10


# ════════════════════════════════════════════════════════════════════════════
#  6. http_call ${VAR} substitution  (ADR-032)
# ════════════════════════════════════════════════════════════════════════════
# `http_call` resolves ${VAR} tokens in url / headers / body using a whitelist.
# Default whitelist (always allowed if set):
#   ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY,
#   SLACK_WEBHOOK_URL, GITHUB_TOKEN, GCAL_ICS_URL
# Add comma-separated extras here (e.g. "FOO_KEY,BAR_TOKEN").
# ALLOWED_TEMPLATE_VARS=

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GITHUB_TOKEN=
# SLACK_WEBHOOK_URL=


# ════════════════════════════════════════════════════════════════════════════
#  7. WorkOS HTTP resource-server auth  (ADR-053)  —  ALL-OR-NOTHING
# ════════════════════════════════════════════════════════════════════════════
# Every /mcp request requires a valid WorkOS-issued Bearer token when all
# four are set.  If any one is missing, the server refuses to start (raises
# in pydantic validator) — set all four or leave all four blank.
# Leaving them blank → trust-only mode: X-User-Id header is taken on faith.
# **NEVER** ship trust-only mode to the public internet.
#
# WORKOS_AUDIENCE = value compared against the JWT ``aud`` claim. AuthKit
# (User Management flow, see ADR-063 / issue #203) mints `aud = client_id`,
# so this is typically the WorkOS Client ID. RFC 8707 resource-indicator
# binding into a single URL value is still tracked separately under #189.
#
# WORKOS_RESOURCE_URL = URL identifying this resource server, advertised in the
# PRM (RFC 9728) ``resource`` field. Defaults to ``${CONNECTIONS_BASE_URL}/mcp``
# when unset. Override only if your MCP endpoint lives at a non-standard path.

# WORKOS_ISSUER=https://<your-tenant>.authkit.app
# WORKOS_JWKS_URI=https://<your-tenant>.authkit.app/oauth2/jwks
# WORKOS_AUDIENCE=client_01...
# WORKOS_RESOURCE_URL=https://scheduler.yourdomain.com/mcp

# WORKOS_API_BASE_URL = WorkOS REST API host for AuthKit User Management
# endpoints (/user_management/authorize, /user_management/authenticate).
# Defaults to https://api.workos.com — override only for sandbox / testing.
# IMPORTANT: this is NOT the AuthKit subdomain (workos_issuer). The AuthKit
# subdomain aliases legacy /sso/* but returns 404 for /user_management/*
# (verified 2026-05-23 per ADR-063 / issue #203).
# WORKOS_API_BASE_URL=https://api.workos.com


# ════════════════════════════════════════════════════════════════════════════
#  8. WorkOS web OAuth + session cookie  (ADR-058)
# ════════════════════════════════════════════════════════════════════════════
# Required for the /connections dashboard login flow.  When absent the
# dashboard runs in trust-only mode (uses MCP_USER_ID).

# WORKOS_CLIENT_ID=client_01...
# WORKOS_CLIENT_SECRET=sk_test_...

# Base URL of THIS server — the URL a BROWSER reaches it on.
# Used for:
#   1. OAuth callback URLs (GitHub / Slack / Google / WorkOS).
#      MUST exactly match the redirect URI registered in each provider.
#   2. The `connect_url` field in MISSING_CONNECTION error envelopes —
#      whatever you set here is what users see in their MCP client when
#      an action handler can't find their OAuth token (ADR-058).
#   3. The PRM `resource` field (RFC 9728) — defaults to ${this}/mcp.
#
# By deployment path (README §3):
#   Path A — operator-managed; you don't run this server.
#   Path B — Self-host HTTP:   http://localhost:8000 (local)
#                              https://your-domain.tld (TLS / production)
#   Path C — Self-host stdio:  http://localhost:8000 (matches the web tier)
#
# ⚠ Mis-set in production → every MISSING_CONNECTION error points users
# at an unreachable URL. Set this BEFORE first run, not after.
CONNECTIONS_BASE_URL=http://localhost:8000

# Signing key for the session JWT cookie.  Random ≥32 bytes in production.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=dev-session-secret-change-in-production


# ════════════════════════════════════════════════════════════════════════════
#  9. AWS KMS envelope encryption for OAuth tokens  (ADR-054)
# ════════════════════════════════════════════════════════════════════════════
# Required for the connection-store to persist any OAuth token (GitHub /
# Slack / Google).  Without these, every connect flow fails at runtime.
# The IAM user needs only:  kms:GenerateDataKey + kms:Decrypt  on this one CMK.

# KMS_KEY_ID=arn:aws:kms:ap-northeast-1:123456789012:key/abcd-...
KMS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Re-fetch a connection's access token when expiry is within this window.
CONNECTION_REFRESH_WINDOW_SECONDS=300


# ════════════════════════════════════════════════════════════════════════════
#  10. GitHub OAuth app  (ADR-058)
# ════════════════════════════════════════════════════════════════════════════
# Powers /connections/github/connect.  Scope requested: "read:user repo".
# Callback URL to register at GitHub:
#   {CONNECTIONS_BASE_URL}/connections/github/callback

# GITHUB_CLIENT_ID=Iv1.xxxx
# GITHUB_CLIENT_SECRET=ghs_...


# ════════════════════════════════════════════════════════════════════════════
#  11. Slack OAuth app  (ADR-058, issue #139)
# ════════════════════════════════════════════════════════════════════════════
# Powers /connections/slack/connect.  Scope: "chat:write chat:write.public".
# Callback URL to register at Slack:
#   {CONNECTIONS_BASE_URL}/connections/slack/callback

# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=


# ════════════════════════════════════════════════════════════════════════════
#  12. Google OAuth client (Gmail send)  (ADR-058, ADR-045)
# ════════════════════════════════════════════════════════════════════════════
# Powers /connections/google/connect and the `email_send` action.
# Scope: "https://www.googleapis.com/auth/gmail.send".
# Authorised redirect URI to register in Google Cloud Console:
#   {CONNECTIONS_BASE_URL}/connections/google/callback

# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...


# ════════════════════════════════════════════════════════════════════════════
#  13. Operator-subsidised LLM actions  (ADR-052)
# ════════════════════════════════════════════════════════════════════════════
# Required for `llm_summarize` + `llm_polish`.  Operator pays; callers cannot
# override model or prompt.  Endpoint must be OpenAI-compatible.

LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_INPUT_CHARS=16000
LLM_DAILY_TOKEN_BUDGET_PER_USER=10000
# Leave blank to disable the app-side monthly ceiling (provider dashboard
# remains the hard stop).
# LLM_GLOBAL_MONTHLY_TOKEN_CEILING=


# ════════════════════════════════════════════════════════════════════════════
#  14. Better Stack structured logs  (ADR-056)
# ════════════════════════════════════════════════════════════════════════════
# When set, a queued LogtailHandler ships JSON logs to Better Stack.
# Leave blank in local dev — logs go to stdout only.

# BETTER_STACK_SOURCE_TOKEN=
