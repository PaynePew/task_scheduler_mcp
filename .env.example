# Copy this file to .env and adjust values for your local environment.
# .env is gitignored — never commit real credentials.

# Async URL for runtime services (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app

# Sync URL for Alembic migrations (psycopg)
ALEMBIC_DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app

# SQS / ElasticMQ queue URL
QUEUE_URL=http://elasticmq:9324/queue/task-queue

# Fallback user identity for stdio transport and HTTP requests without an identity header
MCP_USER_ID=default-user

# HTTP transport bind port (used by the mcp-http entrypoint)
PORT=8000

# Logging verbosity
LOG_LEVEL=INFO

# Dead-letter queue URL — added in S07b when the DLQ is wired
# QUEUE_DLQ_URL=http://elasticmq:9324/queue/task-dlq
